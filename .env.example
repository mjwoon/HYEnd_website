# ==========================================
# HY-END System Environment Variables Example
# ==========================================

# -----------------
# Backend Settings
# -----------------
# JWT Secret Key for Authentication (Base64, 256-bit 이상)
# 새로 생성: openssl rand -base64 32
SECRET_KEY=replace_me_with_base64_encoded_32byte_secret

# File Storage Configuration (local | s3)
FILE_STORAGE_TYPE=local

# -----------------
# AWS S3 Settings (Required if FILE_STORAGE_TYPE=s3)
# -----------------
AWS_S3_BUCKET=your_s3_bucket_name_here
AWS_S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# -----------------
# Frontend & Admin Settings
# -----------------
# API URL for Frontend & Admin to connect to Backend
VITE_API_URL=http://localhost:8080

# LiveKit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_SERVER_URL=https://your-project.livekit.cloud

# OpenAI
OPENAI_API_KEY=sk-...

# Firebase
FIREBASE_CREDENTIALS_PATH=/app/config/firebase-service-account.json
